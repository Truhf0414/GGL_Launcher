{
  "name": "GGL_launcher",
  "version": "1.0.0",
  "description": "年糕122做的Minecraft啟動器，可以拿來玩GGL3的伺服器",
  "main": "main.js",
  "author": "",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:css": "npx --yes @tailwindcss/cli -c tailwind.config.js -i tailwind.css -o assets/tailwind.css --minify",
    "build:icons": "node scripts/build-icons.js",
    "build:rpc-helper": "npm --prefix rpc-helper install --no-audit --no-fund && cd rpc-helper && npx --yes pkg index.js --targets node18-win-x64 --output ../assets/rpc-helper.exe",
    "docs:ipc": "node scripts/update-ipc-index.js",
    "dist:win": "npm run check:ui-css:strict && npm run docs:ipc && npm run build:css && npm run build:rpc-helper && node scripts/generate-electron-builder-config.cjs && electron-builder --config scripts/.electron-builder.generated.json --win nsis --x64 && npm run check:packaged-artifacts",
    "pack:win": "npm run check:ui-css:strict && npm run docs:ipc && npm run build:css && npm run build:rpc-helper && node scripts/generate-electron-builder-config.cjs && electron-builder --config scripts/.electron-builder.generated.json --win dir --x64 && npm run check:packaged-artifacts",
    "format": "prettier --write **/*.{js,cjs,css,html,json,md,yml,yaml} --ignore-unknown",
    "format:file": "prettier --write",
    "check:ui-css": "node scripts/check-ui-css.cjs && node scripts/check-renderer-scripts.cjs",
    "check:ui-css:strict": "node scripts/check-ui-css.cjs --strict && node scripts/check-renderer-scripts.cjs",
    "check:packaged-artifacts": "node scripts/check-packaged-artifacts.cjs",
    "test": "node --require ./test/helpers/forbid-electron.cjs --test \"test/*.test.cjs\"",
    "test:freeze": "node --require ./test/helpers/forbid-electron.cjs --require ./scripts/freeze-on-request.cjs --test \"test/*.test.cjs\"",
    "publish": "node scripts/publish.js",
    "video:bg:downscale": "node scripts/downscale-bg-video.cjs",
    "prepare": "husky",
    "lint": "eslint ."
  },
  "dependencies": {
    "extract-zip": "^2.0.1",
    "undici": "8.12.3"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.12",
    "electron": "^44.3.0",
    "electron-builder": "^26.0.12",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "pkg": "^5.8.1",
    "png-to-ico": "^2.1.1",
    "prettier": "^3.8.3",
    "sharp": "^0.34.3",
    "tailwindcss": "^4.1.12"
  },
  "build": {
    "appId": "ggl3.launcher",
    "productName": "GGL Launcher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "package.json",
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "main/**/*",
      "lib/**/*",
      "renderer/**/*",
      "assets/tailwind.css",
      "assets/notice-thumb.svg",
      "assets/icon.ico",
      "assets/fonts/fusion-pixel-12px-proportional-zh_hant.ttf",
      "node_modules/**/*",
      "!assets/rpc-helper.exe",
      "!assets/*.mp4",
      "!node_modules/**/test{,s}/**",
      "!node_modules/**/__tests__/**",
      "!node_modules/**/docs/**",
      "!node_modules/**/.github/**"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "assets/rpc-helper.exe",
        "to": "assets/rpc-helper.exe"
      },
      {
        "from": "assets/sakura_field_BG.mp4",
        "to": "assets/sakura_field_BG.mp4"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "GGL-Launcher-Setup-${version}.exe"
    }
  }
}
